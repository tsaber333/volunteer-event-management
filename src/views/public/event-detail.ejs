<%- include('../partials/header', { title, user: locals.user, layoutVariant: 'public' }) %>

<% const { fmt12 } = helpers; %>
<% const isPotluck = String(event.signup_mode || '').toLowerCase() === 'potluck'; %>
<% const brandInfo = locals.brand || {}; %>
<% const supportEmail = brandInfo.supportContactEmail || ''; %>
<% const supportName = brandInfo.supportContactName || brandInfo.orgName || 'our team'; %>
<% const isPreview = typeof preview !== 'undefined' && preview; %>
<% const mine = locals.mySignup || null; %>
<% const draftReg = locals.draftRegistration || null; %>
<% const draftRegistrant = (draftReg && draftReg.registrant) || {}; %>
<% const stations = Array.isArray(event.stations) ? event.stations : Object.values(event.stations || {}); %>
<% const hasSlots = stations.some(s => Array.isArray(s.time_blocks) && s.time_blocks.length > 0); %>
<% const spotWord = isPotluck ? 'item' : 'spot'; %>

<section class="page-header page-header--compact page-shell">
  <div>
    <% if (!isPreview) { %>
      <a href="/events" class="btn-link">&larr; Back to sign-ups</a>
    <% } %>
    <h1>
      <% if (isPreview) { %>
        <span class="preview-chip" title="Admin-only preview">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M2 12s4.5-7 10-7 10 7 10 7-4.5 7-10 7-10-7-10-7Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="12" cy="12" r="3" fill="currentColor"/>
          </svg>
          Preview
        </span>
      <% } %>
      <%= event.name %>
    </h1>
    <% const _s = new Date(event.date_start); const _e = new Date(event.date_end); const _same = _s.getFullYear()===_e.getFullYear() && _s.getMonth()===_e.getMonth() && _s.getDate()===_e.getDate(); %>
    <% if (_same) { %>
      <p class="page-subtitle"><%= _s.toLocaleDateString(undefined, { month:'short', day:'numeric', year:'numeric' }) %> — <%= _s.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'}) %> to <%= _e.toLocaleTimeString(undefined,{hour:'numeric',minute:'2-digit'}) %></p>
    <% } else { %>
      <p class="page-subtitle"><%= fmt12(event.date_start) %> — <%= fmt12(event.date_end) %></p>
    <% } %>
  </div>
  <% if (typeof backTo === 'string' && backTo) { %>
    <div class="page-header__actions">
      <a href="<%= backTo %>" class="btn btn-accent small">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M11 19l-7-7 7-7v4h9v6h-9v4z"/></svg>
        Return to manage
      </a>
    </div>
  <% } %>
</section>

<section class="page-section page-section--compact page-shell">
  <% if (event.description) { %>
    <article class="card card--plain">
      <div class="rich-text"><%- helpers.renderRichText(event.description) %></div>
    </article>
  <% } %>
  <details class="page-help event-detail__help">
    <summary class="page-help__summary">
      <span class="page-help__summary-title">How signing up works</span>
      <span class="page-help__summary-meta">Tap or click for quick tips</span>
    </summary>
    <div class="page-help__body">
      <ol>
        <li>Browse the <%= spotWord %>s below and tap “Sign up” on anything you can help with.</li>
        <li>Enter your contact info and choose who is filling each <%= spotWord %> — you, or someone you are signing up.</li>
        <li>Confirm. We’ll email a link so you can see, change, or add to your sign-up later.</li>
      </ol>
      <p>More detail: <a href="/help">volunteer help guide</a>.</p>
      <% if (supportEmail) { %>
        <p class="page-help__contact">
          Questions? Email <strong><%= supportName %></strong> at
          <a class="page-help__email" href="mailto:<%= supportEmail %>"><%= supportEmail %></a>.
        </p>
      <% } %>
    </div>
  </details>
</section>

<%- include('../partials/messages') %>

<% if (mine) { %>
  <section class="page-section page-section--compact page-shell" aria-labelledby="your-signups-heading">
    <article class="card card--plain my-signup">
      <h2 id="your-signups-heading" class="my-signup__title">You’re signed up<%= mine.registrantName ? `, ${mine.registrantName.split(' ')[0]}` : '' %>!</h2>
      <p class="muted">Here’s what your group already has for this event (<%= mine.total %> <%= mine.total === 1 ? spotWord : spotWord + 's' %>).</p>
      <ul class="my-signup__list">
        <% mine.people.filter(p => p.items.length).forEach(p => { %>
          <li>
            <strong><%= p.name %></strong>
            <ul>
              <% p.items.forEach(item => { %>
                <li><%= item.label %><% if (item.dishName) { %> <span class="muted">(<%= item.dishName %>)</span><% } %></li>
              <% }) %>
            </ul>
          </li>
        <% }) %>
      </ul>
      <div class="action-row">
        <a class="btn btn-primary" href="<%= mine.manageUrl %>">Add more or make changes</a>
        <form action="/events/<%= event.event_id %>/forget" method="POST" class="inline-form">
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <button type="submit" class="btn btn-link">Not you? Start a new sign-up</button>
        </form>
      </div>
    </article>
  </section>
<% } else if (!isPreview) { %>
  <section class="page-section page-section--compact page-shell" aria-label="Manage link reminder">
    <details class="disclosure">
      <summary class="disclosure__summary">
        <svg class="disclosure__icon" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-6h2v6Zm-1-8.75a1.25 1.25 0 1 1 0-2.5 1.25 1.25 0 0 1 0 2.5Z"/></svg>
        Already signed up? See what you have
      </summary>
      <div class="disclosure__panel">
        <form action="/manage/remind" method="POST" class="disclosure__form" novalidate>
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <input type="hidden" name="eventId" value="<%= event.event_id %>">
          <label class="sr-only" for="remind-email">Email</label>
          <input id="remind-email" class="input-inline" type="email" name="email" placeholder="Enter the email you used to sign up" required>
          <button type="submit" class="btn btn-outline">Email me my link</button>
        </form>
        <p class="disclosure__help">We’ll email a secure link that shows your current sign-ups, where you can add more or make changes.</p>
      </div>
    </details>
  </section>
<% } %>

<% if (hasSlots) { %>
  <section class="page-section page-section--compact page-shell" id="positions" aria-labelledby="positions-heading">
    <h3 id="positions-heading" class="step-heading">
      <%= mine ? 'What’s still needed' : (isPotluck ? 'Step 1: Choose what you’d like to bring' : 'Step 1: Choose where you’d like to help') %>
    </h3>
    <%- include('../partials/positions', {
      event,
      isPotluck,
      mode: mine ? 'remembered' : 'signup',
      summary: mine,
      addBaseUrl: mine ? mine.manageUrl : ''
    }) %>
  </section>

  <% if (!mine) { %>
    <section class="page-section page-shell" id="signup-step" aria-labelledby="signup-step-heading">
      <h3 id="signup-step-heading" class="step-heading">Step 2: Tell us who’s coming</h3>
      <article class="card card--plain signup-panel">
        <p class="muted" data-role="picks-empty">Tap “Sign up” on any <%= spotWord %> above. Your picks will show up here.</p>
        <form id="signup-form" action="/signup" method="POST" novalidate data-role="picks-form" hidden>
          <input type="hidden" name="_csrf" value="<%= locals.csrfToken %>">
          <input type="hidden" name="eventId" value="<%= event.event_id %>">
          <input type="hidden" name="registration_payload" data-role="payload" value="">
          <div class="notice notice--error" data-role="form-error" role="alert" hidden></div>

          <fieldset class="signup-fieldset">
            <legend>Your contact info</legend>
            <div class="form-grid two">
              <div class="form-group">
                <label for="signup-name">Your name</label>
                <input type="text" id="signup-name" name="name" autocomplete="name" placeholder="Full name" value="<%= draftRegistrant.name || '' %>" required>
              </div>
              <div class="form-group">
                <label for="signup-email">Email</label>
                <input type="email" id="signup-email" name="email" autocomplete="email" placeholder="you@example.com" value="<%= draftRegistrant.email || '' %>" required>
              </div>
              <div class="form-group full">
                <label for="signup-phone">Phone (optional)</label>
                <input type="tel" id="signup-phone" name="phone" autocomplete="tel" placeholder="(555) 555-1234" value="<%= draftRegistrant.phone || '' %>">
              </div>
            </div>
            <p class="muted small">We’ll email a confirmation with a link to see, change, or add to your sign-up.</p>
          </fieldset>

          <fieldset class="signup-fieldset">
            <legend>Who’s filling each <%= spotWord %>? <span class="selection-count-badge" data-role="picks-count"></span></legend>
            <p class="muted small">You don’t have to fill a spot yourself — your name and email are just so we can reach you. For family or friends, choose “Someone else…” and type their name. One person can’t take the same <%= spotWord %> twice<%= (!isPotluck && !event.allow_overlap) ? ' or two spots at the same time' : '' %>.</p>
            <ul class="pick-list" data-role="picks-list"></ul>
          </fieldset>

          <div class="card-actions">
            <button type="submit" class="btn btn-primary">Confirm sign-up</button>
          </div>
        </form>
      </article>
    </section>

    <div class="picks-bar" data-role="picks-bar" hidden>
      <span class="picks-bar__text" data-role="picks-bar-text"></span>
      <button type="button" class="btn btn-primary" data-role="picks-bar-go">Continue</button>
    </div>

    <script type="application/json" id="signup-data"><%- helpers.jsonForScript({
      mode: 'signup',
      eventId: event.event_id,
      isPotluck,
      allowOverlap: !!event.allow_overlap,
      draft: draftReg
    }) %></script>
  <% } %>
<% } else { %>
  <section class="page-section page-shell">
    <article class="card card--plain empty-state">
      <h2>No sign-ups available yet</h2>
      <p class="muted">There are no sign-ups available for this event yet. Please check back soon or reach out to the coordinator.</p>
      <div class="action-row">
        <a class="btn btn-ghost" href="/events">Back to sign-ups</a>
      </div>
    </article>
  </section>
<% } %>

<%- include('../partials/footer', { pageScripts: ['/js/signup.js'] }) %>
