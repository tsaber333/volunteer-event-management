<%- include('../partials/header', { title, user: locals.user, layoutVariant: 'public' }) %>

<% const summaryData = locals.summary || null; %>

<section class="page-header page-shell">
  <div>
    <% if (alreadyRegistered) { %>
      <h1>You already have a sign-up for this event</h1>
      <p class="page-subtitle">We sent an email to <strong><%= volunteerEmail %></strong>.</p>
    <% } else { %>
      <h1>Thank you for signing up!</h1>
      <p class="page-subtitle">A confirmation email is on its way to <strong><%= volunteerEmail %></strong>.</p>
    <% } %>
  </div>
</section>

<section class="page-section page-shell">
  <article class="card card--plain my-signup">
    <% if (alreadyRegistered) { %>
      <% if (locals.heldCount) { %>
        <h2 class="my-signup__title">Check your email to finish</h2>
        <p>Open the email and tap <strong>Add these to my sign-up</strong>. Your <%= heldCount %> new <%= heldCount === 1 ? 'spot' : 'spots' %> will be ready — just press <strong>Save changes</strong>. It works on your phone or computer.</p>
      <% } else { %>
        <h2 class="my-signup__title">Open the link in your email</h2>
        <p>It shows what you already have for this event, and you can add more spots there.</p>
      <% } %>
      <p class="muted small">Can’t find it? Check your junk or spam folder.</p>
    <% } else { %>
      <h2 class="my-signup__title">You’re all set<%= eventName ? ` for ${eventName}` : '' %></h2>
      <p class="muted">You reserved <strong><%= count %></strong> <%= count === 1 ? 'spot' : 'spots' %>:</p>
      <% if (summaryData && summaryData.people.length) { %>
        <ul class="my-signup__list">
          <% summaryData.people.filter(p => p.items.length).forEach(p => { %>
            <li>
              <strong><%= p.name %></strong>
              <ul>
                <% p.items.forEach(item => { %>
                  <li><%= item.label %><% if (item.dishName) { %> <span class="muted">(<%= item.dishName %>)</span><% } %></li>
                <% }) %>
              </ul>
            </li>
          <% }) %>
        </ul>
      <% } %>
      <p class="muted small">Need to change something or add more? Use the link in your email, or the button below.</p>
      <%- include('../partials/calendar-links', { calendar: locals.calendar }) %>
    <% } %>
    <div class="action-row">
      <% if (!alreadyRegistered && typeof manageUrl !== 'undefined' && manageUrl) { %>
        <a href="<%= manageUrl %>" class="btn btn-primary">See or change my sign-up</a>
      <% } %>
      <% if (typeof eventId !== 'undefined' && eventId) { %>
        <a href="/events/<%= eventId %>" class="btn btn-ghost">Back to this event</a>
      <% } %>
      <a href="/events" class="btn btn-ghost">Browse more sign-ups</a>
    </div>
  </article>
</section>

<%- include('../partials/footer') %>
